{
    "name": "refactor-circus/stretch",
    "description": "A Laravel package for building Elasticsearch queries with a fluent, intuitive API",
    "keywords": [
        "laravel",
        "elasticsearch",
        "query-builder",
        "search",
        "stretch"
    ],
    "homepage": "https://github.com/refactor-circus/stretch",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "jayjfletcher@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "elasticsearch/elasticsearch": "^8.0|^9.5",
        "illuminate/container": "^12.0|^13.35",
        "illuminate/contracts": "^12.0|^13.35",
        "illuminate/pagination": "^12.0|^13.35",
        "illuminate/support": "^12.0|^13.35",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "require-dev": {
        "brianium/paratest": "^7.26",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^10.0|^11.3",
        "pestphp/pest": "^5.3.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "spatie/laravel-ray": "^1.43.9"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Stretch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Stretch\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "@phpstan",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "@pint",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "pint": "vendor/bin/pint -v --preset laravel",
        "pint:test": "vendor/bin/pint --test --preset laravel",
        "post-install-cmd": [
            "@php bin/install-git-hooks.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Stretch\\StretchServiceProvider"
            ],
            "aliases": {
                "Stretch": "RefactorCircus\\Stretch\\Facades\\Stretch"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
